# Gradle
.gradle/
build/
out/

# Release artifacts are published as GitHub Release assets, not committed.
# A jar is a 100 KB binary that changes on every build; keeping it out of git
# keeps the history diffable and avoids a stale copy in the tree.
dist/

# ForgeGradle run directories (generated on first launch)
run/
runs/
logs/
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
bin/

# OS
.DS_Store
Thumbs.db

# Local cache written by Linggango Sync at runtime
config/linggangosync.json
config/linggangosync-cache.bin

# mcmodsrepo is only produced by `gradle publishToMavenLocal`-style tasks
mcmodsrepo/
